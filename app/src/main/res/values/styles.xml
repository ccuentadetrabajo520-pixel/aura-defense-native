<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AuraDefense" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/aura_background</item>
        <item name="android:navigationBarColor">@color/aura_background</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="Theme.AuraDefense.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/aura_core_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/aura_core_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.AuraDefense</item>
    </style>
</resources>
